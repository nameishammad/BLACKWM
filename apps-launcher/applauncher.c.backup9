  UI_NONE = 0,
  UI_TAB0 = 1, /* Applications */
  UI_TAB1 = 2, /* Places */
  UI_POW0 = 3, /* 3..5 */
  UI_CHEV = 6,
  UI_CONF = 7,
  UI_PIN = 8,
  UI_SIDE0 = 100
};

