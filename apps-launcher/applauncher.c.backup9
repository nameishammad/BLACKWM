/*
 * applauncher.c - KDE Neon style (Kickoff) application launcher
 *                 X11 / xcb / cairo
 *
 * Layout (matches the reference screenshot):
 *   - translucent rounded panel, opens at the bottom-left
 *   - header : round profile picture + real user name | search | sliders, pin
 *   - left   : Favorites, All Applications, then the categories
 *   - right  : icon grid
 *   - bottom : [Applications] [Places] ........ Sleep  Restart  Shut Down  <
 *
 * The name shown in the header is the real account name (full name from
 * /etc/passwd, else the login) and the picture is the real profile picture
 * (~/.face.icon, ~/.face, AccountsService).
 *
 * Build:
 *   gcc -O2 -o applauncher applauncher.c \
 *     $(pkg-config --cflags --libs gtk+-3.0 cairo cairo-xcb xcb xcb-keysyms) -lm
 *
 * Keys:
 *   type            search all applications
 *   arrows          move selection
 *   Tab/Shift+Tab   next/previous section
 *   PgUp/PgDn       scroll a page
 *   Enter           launch      Esc  close
 * Mouse:
 *   click tile = launch, right-click tile = add/remove favorite,
 *   click sidebar = section, wheel = scroll, click outside = close,
 *   pin button = keep the launcher open
 *
 * Favorites are stored in ~/.config/applauncher/favorites (one .desktop id
 * per line).
 */
