/* ---------------- data ---------------- */
typedef struct {
  char name[NAME_LEN];
  char exec[EXEC_LEN];
  char icon[ICON_LEN];
  char id[ID_LEN]; /* .desktop file name without the suffix */
  int terminal;
  unsigned cats; /* bitmask of 1 << SEC_* */
  int fav;       /* 0 = not a favorite, otherwise its position */
  GdkPixbuf *pixbuf;
  int icon_loaded;
} AppEntry;

typedef struct {
  double x, y, w, h;
} Rect;

/* ids of clickable things (see hit_ui) */
